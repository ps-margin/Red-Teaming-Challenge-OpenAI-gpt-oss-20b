# API Keys for Chain of Thought Vulnerability Reproduction Notebook
# Copy this file to .env and add your actual API keys

# Groq API Key (Required - supports gpt-oss-20b model for vulnerability testing)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (Required - for advanced LLM-based content evaluation using Google GenAI SDK)  
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Additional configuration
# OPENAI_API_KEY=your_openai_key_here (if testing with OpenAI models)

# Installation note:
# pip install google-genai

# Notes:
# - GROQ_API_KEY: Required for testing gpt-oss-20b vulnerability
# - GEMINI_API_KEY: Required for sophisticated harmful content detection using Gemini 2.5 Flash
# - Uses official Google GenAI SDK for better reliability and error handling
# - Both services offer generous free tiers perfect for research
# - Dual LLM evaluation provides much higher accuracy than rule-based detection